# Copy to .env and fill in. NEVER commit .env — it is gitignored.

PORT=3001
ARCHIVE_CONTAINER=archive
CHECK_TIMEOUT_MS=15000

# ── Finding the SRD storage accounts ─────────────────────────────────────────
# Auto-discover every "*srd01" account your `az login` identity can see. Keys are read at runtime
# (management-plane listKeys, like the Azure Portal's "Access key" view): nothing is written to disk and no
# data-plane RBAC role is needed.
STORAGE_DISCOVER=true
DISCOVER_SUFFIX=srd01

# Optional: limit every query (discovery, bots, databases) to specific subscription IDs, comma-separated
# SUBSCRIPTIONS=

# Or list account NAMES explicitly instead of discovering them:
# STORAGE_ACCOUNTS=mseprdukssasrd01,tsiprduse2sasrd01,enxprdfrcsasrd01

# In a deployed environment, use the app's managed identity instead of az login:
# USE_MANAGED_IDENTITY=true

# ── Bot storage (anything stuck in the audio-video container) ────────────────
# BOT_CONTAINER=audio-video
# BOT_ACCOUNT_PREFIX=botstorage     # empty value disables the check
# BOT_STUCK_MINUTES=60              # untouched this long = stuck
# BOT_WINDOW_DAYS=3                 # only list stuck interactions from the last N days

# ── Databases ────────────────────────────────────────────────────────────────
# DTU_THRESHOLD=90                  # DTU % above which a database is flagged
# DTU_LOOKBACK_MINUTES=15           # how far back to find the latest DTU reading

# ── Network (default: this machine only) ─────────────────────────────────────
# The server listens on 127.0.0.1 and only answers to localhost names. To share it on purpose, set both of these AND put it
# behind something that signs people in (the tool has no login of its own):
# HOST=0.0.0.0
# ALLOWED_HOSTS=monitor.example.com

# ── Speed / refresh (defaults shown; the scheduled-task launcher sets REFRESH_MS=900000) ──
# REFRESH_MS=60000
# SCAN_CONCURRENCY=20      # accounts scanned in parallel
# BOT_CONCURRENCY=4        # bot-storage accounts listed at once (background phase)
# CACHE_DIR=               # where the last results are kept (default: backend/.cache, git-ignored)
# KEY_CONCURRENCY=32
# INFRA_CONCURRENCY=40

# ── FALLBACK: connection strings (contain keys; discouraged) ─────────────────
# STORAGE_CONN_1=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
