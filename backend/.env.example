# Copy to .env and fill in. NEVER commit .env — it is gitignored.

PORT=3001
ARCHIVE_CONTAINER=archive
CHECK_TIMEOUT_MS=15000

# ── PREFERRED: portal-style, no stored secret ────────────────────────────────
# List account NAMES only. The app reads each account's key at runtime via your
# `az login` identity (management-plane listKeys) — exactly like the Azure
# Portal's "Access key" view. No keys are written to disk and no data-plane RBAC
# role is required (your existing management access is enough).
STORAGE_ACCOUNTS=mseprdukssasrd01,tsiprduse2sasrd01,enxprdfrcsasrd01

# In a deployed environment, use the app's managed identity instead of az login:
# USE_MANAGED_IDENTITY=true

# ── FALLBACK: connection strings (contain keys; discouraged) ─────────────────
# STORAGE_CONN_1=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
